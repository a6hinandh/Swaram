{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OCRRegisterContract",
  "description": "Schemas for paper register digitization and table extraction",
  "type": "object",
  "required": ["batch_id", "image_ref", "processed_at", "rows"],
  "properties": {
    "batch_id": { "type": "string", "format": "uuid" },
    "image_ref": { "type": "string" },
    "processed_at": { "type": "string", "format": "date-time" },
    "engine_used": { "type": "string", "enum": ["paddleocr", "tesseract", "mock"] },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["row_index", "confidence", "fields"],
        "properties": {
          "row_index": { "type": "integer" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "fields": {
            "type": "object",
            "properties": {
              "serial_no": { "type": "string" },
              "house_number": { "type": "string" },
              "head_of_household": { "type": "string" },
              "beneficiary_name": { "type": "string" },
              "age": { "type": "string" },
              "lmp_date": { "type": "string" },
              "immunisation_status": { "type": "string" }
            }
          },
          "matched_household_id": { "type": "string", "format": "uuid" },
          "match_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "review_status": {
            "type": "string",
            "enum": ["unreviewed", "confirmed", "rejected", "edited"],
            "default": "unreviewed"
          }
        }
      }
    }
  }
}
