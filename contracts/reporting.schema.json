{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReportingContract",
  "description": "Schemas for PreparedForm, SubmissionResult, and ActionItem in Swaram",
  "definitions": {
    "ActionItem": {
      "type": "object",
      "required": ["action_id", "household_id", "title", "assigned_to", "due_date", "status"],
      "properties": {
        "action_id": { "type": "string", "format": "uuid" },
        "household_id": { "type": "string", "format": "uuid" },
        "care_gap_id": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "assigned_to": { "type": "string" },
        "due_date": { "type": "string", "format": "date" },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "completed", "cancelled"],
          "default": "pending"
        }
      }
    },
    "PreparedForm": {
      "type": "object",
      "required": ["form_id", "target_portal", "mapped_fields", "validation_passed"],
      "properties": {
        "form_id": { "type": "string", "format": "uuid" },
        "target_portal": {
          "type": "string",
          "enum": [
            "swaram_health_portal",
            "mock_shaili_portal",
            "mock_anmol_portal",
            "mock_rch_portal",
            "mock_ncd_portal"
          ]
        },
        "visit_ref_id": { "type": "string", "format": "uuid" },
        "mapped_fields": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "validation_passed": { "type": "boolean" },
        "missing_fields": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "SubmissionResult": {
      "type": "object",
      "required": ["submission_id", "form_id", "status", "timestamp"],
      "properties": {
        "submission_id": { "type": "string", "format": "uuid" },
        "form_id": { "type": "string", "format": "uuid" },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "pending_worker_confirmation"]
        },
        "acknowledgement_number": { "type": "string" },
        "error_message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
