{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VisitContract",
  "description": "Schemas for VisitDraft and ConfirmedVisit in Swaram",
  "definitions": {
    "Vitals": {
      "type": "object",
      "properties": {
        "systolic_bp": { "type": "number", "minimum": 60, "maximum": 250 },
        "diastolic_bp": { "type": "number", "minimum": 40, "maximum": 150 },
        "weight_kg": { "type": "number", "minimum": 1, "maximum": 200 },
        "temperature_c": { "type": "number", "minimum": 34, "maximum": 43 },
        "hemoglobin_g_dl": { "type": "number", "minimum": 3, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "PersonUpdate": {
      "type": "object",
      "required": ["person_id", "name"],
      "properties": {
        "person_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" },
        "pregnancy_weeks": { "type": "integer", "minimum": 1, "maximum": 45 },
        "vitals": { "$ref": "#/definitions/Vitals" },
        "symptoms": { "type": "array", "items": { "type": "string" } },
        "medications_given": { "type": "array", "items": { "type": "string" } },
        "services_provided": { "type": "array", "items": { "type": "string" } },
        "follow_up_date": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "VisitDraft": {
      "type": "object",
      "required": [
        "visit_id",
        "household_id",
        "worker_id",
        "timestamp",
        "language",
        "transcript",
        "person_updates",
        "confidence"
      ],
      "properties": {
        "visit_id": { "type": "string", "format": "uuid" },
        "household_id": { "type": "string", "format": "uuid" },
        "worker_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "language": { "type": "string", "enum": ["ml", "en"] },
        "transcript": { "type": "string" },
        "person_updates": {
          "type": "array",
          "items": { "$ref": "#/definitions/PersonUpdate" }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "validation_flags": { "type": "array", "items": { "type": "string" } },
        "confirmation_status": {
          "type": "string",
          "enum": ["pending", "confirmed", "corrected"],
          "default": "pending"
        }
      }
    },
    "ConfirmedVisit": {
      "type": "object",
      "required": [
        "visit_id",
        "household_id",
        "worker_id",
        "timestamp",
        "person_updates",
        "confirmed_by_worker_at"
      ],
      "properties": {
        "visit_id": { "type": "string", "format": "uuid" },
        "household_id": { "type": "string", "format": "uuid" },
        "worker_id": { "type": "string", "format": "uuid" },
        "timestamp": { "type": "string", "format": "date-time" },
        "person_updates": {
          "type": "array",
          "items": { "$ref": "#/definitions/PersonUpdate" }
        },
        "audio_record_ref": { "type": "string" },
        "confirmed_by_worker_at": { "type": "string", "format": "date-time" },
        "corrections_made": { "type": "array", "items": { "type": "string" } },
        "sync_status": {
          "type": "string",
          "enum": ["pending", "syncing", "synced", "failed"],
          "default": "pending"
        }
      }
    }
  }
}
