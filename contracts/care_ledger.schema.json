{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HouseholdCareLedger",
  "description": "Schema for Household-level Unresolved Care Ledger",
  "type": "object",
  "required": [
    "household_id",
    "updated_at",
    "open_gaps_count",
    "care_gaps",
    "priority_score"
  ],
  "properties": {
    "household_id": { "type": "string", "format": "uuid" },
    "household_name": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "open_gaps_count": { "type": "integer", "minimum": 0 },
    "care_gaps": {
      "type": "array",
      "items": { "$ref": "care_gap.schema.json" }
    },
    "priority_score": { "type": "number", "minimum": 0 },
    "priority_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "longitudinal_narrative": { "type": "string" }
  }
}
