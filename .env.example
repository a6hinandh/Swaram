# ==============================================================================
# SWARAM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting services
# ==============================================================================

# Mobile Configuration (Module 1)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_VOICE_API_URL=http://localhost:8001/api/v1
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Voice Intelligence (Module 2)
VOICE_SERVICE_PORT=8001
INDIC_CONFORMER_ENDPOINT=mock
INDIC_F5_TTS_ENDPOINT=mock
OPENAI_API_KEY=mock-key-or-gemini-key
LLM_PROVIDER=mock

# Backend & Care Ledger (Module 3)
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./swaram_master.db
# For PostgreSQL in production/docker:
# DATABASE_URL=postgresql://swaram_user:swaram_secret@localhost:5432/swaram_db
SECRET_KEY=change-in-production-secret-key-for-swaram
OCR_ENGINE=paddleocr # Options: paddleocr, tesseract, mock

# Automation & Reporting (Module 4)
MOCK_PORTAL_PORT=8080
MOCK_PORTAL_URL=http://localhost:8080
HEADLESS_BROWSER=true
PLAYWRIGHT_SLOW_MO_MS=250
