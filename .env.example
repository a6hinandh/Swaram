# ==============================================================================
# SWARAM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting services
# ==============================================================================

# Mobile Configuration (Module 1)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_VOICE_API_URL=http://localhost:8001/api/v1
EXPO_PUBLIC_ENABLE_MOCK_FALLBACK=true

# Sarvam AI Voice-to-Text ASR (Primary Malayalam Engine)
EXPO_PUBLIC_SARVAM_API_KEY=sk_ebmc8i23_GSCwz6j4TNMdVHTZDELsGxgj
EXPO_PUBLIC_SARVAM_MODEL=saaras:v4
EXPO_PUBLIC_SARVAM_ENDPOINT=https://api.sarvam.ai/speech-to-text
EXPO_PUBLIC_SARVAM_LANGUAGE_CODE=ml-IN

# Hugging Face ASR Inference API (Fallback)
EXPO_PUBLIC_HF_TOKEN=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
EXPO_PUBLIC_HF_MODEL=openai/whisper-large-v3-turbo
EXPO_PUBLIC_HF_ENDPOINT=https://router.huggingface.co/hf-inference/models/openai/whisper-large-v3-turbo
EXPO_PUBLIC_ASR_LANGUAGE=ml

# AI4Bharat IndicConformer ASR (Dhruva / Bhashini API Fallback)
EXPO_PUBLIC_INDIC_CONFORMER_ENDPOINT=https://api.dhruva.ai4bharat.org/services/inference/asr
EXPO_PUBLIC_AI4BHARAT_API_KEY=mock-ai4bharat-api-key-replace-me
EXPO_PUBLIC_AI4BHARAT_USER_ID=mock-user-id
EXPO_PUBLIC_AI4BHARAT_SERVICE_ID=ai4bharat/conformer-hi-gpu--gpu
EXPO_PUBLIC_ASR_LANGUAGE=ml

# Voice Intelligence (Module 2)
VOICE_SERVICE_PORT=8001
SARVAM_API_KEY=sk_ebmc8i23_GSCwz6j4TNMdVHTZDELsGxgj
SARVAM_MODEL=saaras:v4
INDIC_CONFORMER_ENDPOINT=mock
INDIC_F5_TTS_ENDPOINT=mock
OPENAI_API_KEY=mock-key-or-gemini-key
LLM_PROVIDER=mock

# Backend & Care Ledger (Module 3)
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./swaram_master.db
# For PostgreSQL in production/docker:
# DATABASE_URL=postgresql://swaram_user:swaram_secret@localhost:5432/swaram_db
SECRET_KEY=change-in-production-secret-key-for-swaram
OCR_ENGINE=paddleocr # Options: paddleocr, tesseract, mock

# Automation & Reporting (Module 4)
MOCK_PORTAL_PORT=8080
MOCK_PORTAL_URL=http://localhost:8080
HEADLESS_BROWSER=true
PLAYWRIGHT_SLOW_MO_MS=250
